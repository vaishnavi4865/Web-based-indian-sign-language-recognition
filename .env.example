# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your_secret_key_here

# Database Configuration
DATABASE_URL=sqlite:///sign_language.db
# For MySQL:
# DATABASE_URL=mysql+pymysql://username:password@localhost/sign_language

# Model Paths
CNN_MODEL_PATH=models/cnn_lstm_model.h5
LABELS_PATH=models/labels.pkl

# Upload Settings
UPLOAD_FOLDER=uploads/
MAX_CONTENT_LENGTH=16777216

# Text-to-Speech Settings
TTS_LANGUAGE=en
TTS_ENGINE=gtts

# Webcam Settings
CAMERA_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=480

# MediaPipe Settings
MIN_DETECTION_CONFIDENCE=0.5
MIN_TRACKING_CONFIDENCE=0.5

# Application Settings
DEBUG=True
HOST=127.0.0.1
PORT=5000
